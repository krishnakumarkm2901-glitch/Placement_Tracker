# ============================================================
# Placement Tracker — Environment Variables
# Copy this file as .env and fill in the values
# ============================================================

# ─── MongoDB Atlas ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Placement_Tracker?retryWrites=true&w=majority
MONGODB_DB_NAME=Placement_Tracker

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# ─── GitHub ─────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_personal_access_token

# ─── Flask ──────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0

# ─── CORS / Frontend URL ───────────────────────────────────
# For production: set to your Vercel URL
# For multiple origins: comma-separated (e.g., https://app.vercel.app,http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ─── Server ─────────────────────────────────────────────────
PORT=5000

# ─── Sync & Rate Limiting ──────────────────────────────────
SYNC_INTERVAL_HOURS=12
RATE_LIMIT_PER_MINUTE=100
