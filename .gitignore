# ============================================================
# Placement Tracker - .gitignore
# Full Stack: React + Vite | Python Flask | MongoDB
# ============================================================

# ─── Python Virtual Environments ────────────────────────────
.venv/
venv/
env/
ENV/
.Python

# ─── Python Bytecode & Cache ────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ─── Python Distribution / Packaging ────────────────────────
*.egg-info/
*.egg
dist/
build/
*.whl

# ─── Node.js Dependencies ──────────────────────────────────
node_modules/
client/node_modules/

# ─── Environment Variables ──────────────────────────────────
.env
.env.*
!.env.example
server/.env
client/.env

# ─── Build Output ───────────────────────────────────────────
client/dist/
client/build/
server/dist/
server/build/

# ─── Vite Cache ─────────────────────────────────────────────
client/.vite/
*.local

# ─── IDE / Editor Files ────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── OS Generated Files ────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Log Files ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pip-log.txt

# ─── Testing & Coverage ────────────────────────────────────
coverage/
.coverage
htmlcov/
.pytest_cache/
.nyc_output/

# ─── Temporary Files ───────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig

# ─── Misc ───────────────────────────────────────────────────
.cache/
*.gz
*.zip
*.tar
.eslintcache

*.keystore
*.jks
.gradle/
**/.gradle/
**/build/
*.apk
*.aab
*.idsig


